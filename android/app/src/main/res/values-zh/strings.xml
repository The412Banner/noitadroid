<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="setup_subtitle">Noita 安卓版：首次启动</string>
    <string name="setup_intro">这个应用里没有 Noita 本体：它运行的是你自己的那份游戏，也就是 GOG 上的 Windows 版（版本 %1$s），重编译到了 Android 上。右边列出了它还需要什么。全部就绪后，打开应用会直接进入游戏。</string>
    <string name="setup_ready">全部就绪。</string>
    <string name="setup_not_ready">还没准备好：请看标 ✕ 的项。</string>
    <string name="start">开始游戏</string>
    <string name="recheck">重新检查</string>

    <string name="access_title">存储访问权限</string>
    <string name="access_ok">已授予。游戏从 %1$s 读取，存档也保存在那里。</string>
    <string name="access_missing">需要它才能从共享存储读取游戏（你可以通过 USB 把游戏拷进去），重装应用时存档也不会丢。Android 设置里叫「所有文件访问权限」。</string>
    <string name="access_action">去授权</string>

    <string name="files_title">游戏文件</string>
    <string name="files_waiting">授予存储权限后才能检查。</string>
    <string name="files_missing_all">把你的 Noita 文件夹（有 noita.exe 的那个）里的所有内容拷到 %1$s。用 USB 连电脑时，它在「内部存储 › noitadroid › Noita」，文件夹已经建好了。用 adb 的话，tools/android/push_game.sh 会帮你拷。</string>
    <string name="files_missing_some">%1$s 里有一部分游戏文件，但缺少：%2$s。请把整个 Noita 文件夹（有 noita.exe 的那个）拷进来。</string>
    <string name="files_incomplete">data/data.wak 现在是 %1$s，应该是 %2$s：没拷完（或者还在拷）。</string>
    <string name="files_ok">已在 %1$s 找到。</string>

    <string name="version_title">游戏版本</string>
    <string name="version_waiting">游戏文件就位后才能检查。</string>
    <string name="version_wrong">%1$s 不是这个应用对应的版本。需要的是 GOG 上 Windows 版的 Noita，版本 %2$s（2025 年 1 月 25 日）。Steam 版和其他版本都不行。</string>
    <string name="version_ok">GOG 版 %1$s，与这个应用对应。</string>

    <string name="sound_title">声音（FMOD）</string>
    <string name="sound_ok">此应用已包含 FMOD %1$s。</string>
    <string name="sound_missing">这个应用构建时没有加入 FMOD，所以游戏没有声音。FMOD 的许可证不允许分享它，只能由构建应用的人自己加入（tools/android/setup_fmod.sh）。不影响游玩。</string>

    <!-- 游戏内菜单（GameDrawer）：从左边缘滑出 -->
    <string name="menu_paused">游戏已暂停。</string>
    <string name="menu_saves">存档</string>
    <string name="menu_saves_hint">导出为 zip，或从 zip 导入（电脑版的存档也可以）。</string>
    <string name="menu_export">导出</string>
    <string name="menu_import">导入</string>
    <string name="menu_pad">手柄按键</string>
    <string name="menu_pad_default">没有互换的按键。</string>
    <string name="menu_pad_swapped">已互换：%1$s</string>
    <string name="menu_pad_edit">按键互换…</string>
    <string name="menu_display">显示</string>
    <string name="menu_overlay_on">FPS 和温度：开</string>
    <string name="menu_overlay_off">FPS 和温度：关</string>
    <string name="menu_resume">回到游戏</string>
    <string name="menu_back">返回</string>
    <string name="cancel">取消</string>
    <string name="list_sep">、</string>

    <string name="pad_title">手柄按键互换</string>
    <string name="pad_hint">先选一个按键，再选它要当作哪个键用，两个键会互换。只对游戏生效；摇杆、十字键和扳机不受影响。游戏自带的设置里也能改键位。</string>
    <string name="pad_reset">恢复默认</string>
    <string name="pad_choose">%1$s 当作…</string>
    <string name="pad_choose_hint">被换掉的那个键会接过它原来的功能。</string>

    <string name="export_running">正在导出…</string>
    <string name="export_done">已导出（%1$s），内容是游戏最近一次存盘：游戏在「保存并退出」时保存当前这局。</string>
    <string name="export_failed">导出失败：%1$s</string>
    <string name="import_reading">正在读取 zip…</string>
    <string name="import_failed">导入失败：%1$s</string>
    <string name="import_title">导入这个存档？</string>
    <string name="import_has_run">一局进行中的游戏</string>
    <string name="import_has_progress">进度（解锁内容）</string>
    <string name="import_has_stats">统计</string>
    <string name="import_what">包含%1$s：%2$d 个文件，%3$s。</string>
    <string name="import_warning">它会替换当前存档，当前存档会备份为存档文件夹里的 save00.backup-（日期）。游戏会用导入的存档重启。</string>
    <string name="import_go">导入并重启</string>
</resources>
