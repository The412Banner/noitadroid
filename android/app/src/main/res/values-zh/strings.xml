    <string name="perf_title">性能设置</string>
    <string name="perf_cores">处理器核心</string>
    <string name="perf_device_3">本机有 %1$d 个超大核、%2$d 个大核和 %3$d 个小核。</string>
    <string name="perf_device_2">本机有 %1$d 个大核和 %2$d 个小核，没有单独的最快核心，没有可选的。</string>
    <string name="perf_device_1">本机的 %1$d 个核心都一样，没有可选的。</string>
    <string name="perf_system">系统分配</string>
    <string name="perf_system_hint">由 Android 决定游戏线程放在哪个核心上。</string>
    <string name="perf_split">超大核给主线程</string>
    <string name="perf_split_hint" formatted="false">游戏主线程独占最快的核心，模拟线程用其余核心。实测快 8–16%。</string>
    <string name="perf_boost">超大核身兼两职（推荐）</string>
    <string name="perf_boost_hint" formatted="false">同上，再加一个模拟线程，在主线程等待时使用最快的核心。实测再快 8–13%，温度略高。</string>
    <string name="perf_applies">立即生效。模拟线程的数量在下次启动游戏时调整。</string>

